# Local review defaults. Never deploy an approval bypass.
SITE_LAUNCH_APPROVED=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pureline-owned Sanity project; never reuse an unrelated project.
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
# Import-only token. Remove from the website runtime after importing drafts.
SANITY_API_WRITE_TOKEN=

# Consent-gated analytics. Leave empty until configured and reviewed.
NEXT_PUBLIC_GA_ID=

# Private lead delivery, disabled until approved and integration-tested.
LEADS_ENABLED=false
LEADS_PRIVACY_APPROVED=false
LEADS_PRIVACY_NOTICE_VERSION=
DATABASE_URL=
RESEND_API_KEY=
LEADS_FROM_EMAIL=
LEADS_TO_EMAIL=
LEADS_RATE_LIMIT_SECRET=
LEADS_TRUSTED_IP_HEADER=
